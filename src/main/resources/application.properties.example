# ==== App Basic Config ====
spring.application.name=TiengAnhMoiNgay

properties
# ==== Database Configuration ====
# Primary Writer (Singapore)
spring.datasource.writer.url=jdbc:mysql://aurora-cluster-writer.cluster-abc123.ap-southeast-1.rds.amazonaws.com:3306/TiengAnhMoiNgay
spring.datasource.writer.username=admin
spring.datasource.writer.password=your_password
spring.datasource.writer.driver-class-name=com.mysql.cj.jdbc.Driver

# Local Reader (Singapore)
spring.datasource.reader.url=jdbc:mysql://aurora-cluster-reader.cluster-abc123.ap-southeast-1.rds.amazonaws.com:3306/TiengAnhMoiNgay
spring.datasource.reader.username=admin
spring.datasource.reader.password=your_password
spring.datasource.reader.driver-class-name=com.mysql.cj.jdbc.Driver

# Cross-Region Reader (N.Virginia)
spring.datasource.dr-reader.url=jdbc:mysql://aurora-global-reader.cluster-def456.us-east-1.rds.amazonaws.com:3306/TiengAnhMoiNgay
spring.datasource.dr-reader.username=admin
spring.datasource.dr-reader.password=your_password
spring.datasource.dr-reader.driver-class-name=com.mysql.cj.jdbc.Driver

# Connection Pool Settings
spring.datasource.hikari.maximum-pool-size=20
spring.datasource.hikari.minimum-idle=5
spring.datasource.hikari.connection-timeout=30000
spring.datasource.hikari.idle-timeout=600000


# Logging
logging.level.org.springframework.jdbc=DEBUG
logging.level.com.zaxxer.hikari=DEBUG

# ==== JPA Settings ====
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true
logging.level.org.hibernate.SQL=DEBUG
logging.level.org.hibernate.type.descriptor.sql.BasicBinder=TRACE

# ==== JPA & Hibernate ====
spring.jpa.hibernate.ddl-auto=update
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# ==== Spring Boot Security ====
spring.autoconfigure.exclude=org.springframework.boot.autoconfigure.security.servlet.SecurityAutoConfiguration

# ==== Error Page ====
server.error.path=/error

# ==== File Upload ====
spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=10MB

# ==== Google Gemini API ====
google.gemini.apiKey=<your_google_gemini_api_key>

# ==== JWT Config ====
jwt.secret_key=<your_jwt_secret_key>

# ==== AWS Translate Config ====
aws.iam.access_key=<your_aws_translate_access_key>
aws.iam.secret_key=<your_aws_translate_secret_key>